# Public client settings for Supabase project player-pov
# (ref bfaopibbbldsxvjprfdx, region us-west-1).
# URL: https://bfaopibbbldsxvjprfdx.supabase.co
# Copy to .env.local and fill both values from the dashboard.
# Leave them empty to run the viewer with no login and no backend.
# Never put the service-role key in a VITE_ variable or in git.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paid plans show "Coming soon" until this is true (also set CHECKOUT_ENABLED=true
# as a secret on the billing function). Leave it unset until launch.
VITE_CHECKOUT_ENABLED=
